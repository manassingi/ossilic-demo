<mujoco model="ossilic-rover">
  <option timestep="0.002" integrator="implicitfast"/>
  <default>
    <geom friction="1 0.005 0.0001" condim="3"/>
    <joint damping="0.01"/>
  </default>
  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.9 0.9 0.9" rgb2="0.8 0.8 0.8" width="256" height="256"/>
    <material name="grid" texture="grid" texrepeat="6 6" reflectance="0.1"/>
  </asset>
  <worldbody>
    <light pos="3 3 6" dir="0 0 -1" diffuse="0.9 0.9 0.9"/>
    <geom name="floor" type="plane" size="3 3 0.1" pos="3 3 0" material="grid"/>
    <!-- arena walls, 6 x 6 m -->
    <geom type="box" size="3 0.05 0.25" pos="3 -0.05 0.25" rgba="0.5 0.5 0.55 1"/>
    <geom type="box" size="3 0.05 0.25" pos="3 6.05 0.25" rgba="0.5 0.5 0.55 1"/>
    <geom type="box" size="0.05 3 0.25" pos="-0.05 3 0.25" rgba="0.5 0.5 0.55 1"/>
    <geom type="box" size="0.05 3 0.25" pos="6.05 3 0.25" rgba="0.5 0.5 0.55 1"/>
    <!-- obstacles: same layout as the sim2d target -->
    <geom type="cylinder" size="0.45 0.25" pos="2.0 2.0 0.25" rgba="0.75 0.35 0.2 1"/>
    <geom type="cylinder" size="0.50 0.25" pos="3.5 3.0 0.25" rgba="0.75 0.35 0.2 1"/>
    <geom type="cylinder" size="0.40 0.25" pos="2.8 4.3 0.25" rgba="0.75 0.35 0.2 1"/>
    <geom type="cylinder" size="0.35 0.25" pos="4.5 4.4 0.25" rgba="0.75 0.35 0.2 1"/>

    <body name="chassis" pos="0.5 0.5 0.08">
      <freejoint/>
      <geom type="box" size="0.15 0.12 0.03" mass="2.0" rgba="0.2 0.3 0.8 1"/>
      <geom type="sphere" size="0.025" pos="-0.12 0 -0.055" mass="0.05" friction="0.05 0.001 0.0001" rgba="0.3 0.3 0.3 1"/>
      <geom type="cylinder" size="0.02 0.01" pos="0.14 0 0.03" rgba="0.1 0.1 0.1 1"/>
      <body name="left_wheel" pos="0.02 0.15 0">
        <joint name="left" type="hinge" axis="0 1 0"/>
        <geom type="cylinder" size="0.06 0.02" euler="90 0 0" mass="0.2" rgba="0.1 0.1 0.1 1"/>
      </body>
      <body name="right_wheel" pos="0.02 -0.15 0">
        <joint name="right" type="hinge" axis="0 1 0"/>
        <geom type="cylinder" size="0.06 0.02" euler="90 0 0" mass="0.2" rgba="0.1 0.1 0.1 1"/>
      </body>
    </body>
  </worldbody>
  <actuator>
    <velocity name="left" joint="left" kv="0.5" ctrlrange="-14 14" forcerange="-2 2"/>
    <velocity name="right" joint="right" kv="0.5" ctrlrange="-14 14" forcerange="-2 2"/>
  </actuator>
</mujoco>
